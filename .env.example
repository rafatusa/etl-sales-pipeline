# ─────────────────────────────────────────────────────────────────────────────
# ETL Sales Pipeline — environment variable reference
# Copy this file to .env and fill in your values for local development.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_DEFAULT_REGION=us-east-1

# For local runs using real AWS (S3 bucket must exist):
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# ── S3 ────────────────────────────────────────────────────────────────────────
# Name of the S3 landing bucket (set after first terraform apply)
S3_BUCKET=etl-sales-pipeline-landing-XXXXXXXX

# S3 folder prefixes (defaults shown)
S3_INPUT_PREFIX=input/
S3_PROCESSED_PREFIX=processed/
S3_FAILED_PREFIX=failed/

# ── Database ──────────────────────────────────────────────────────────────────
# For local docker-compose, DB_HOST=postgres (the service name)
# For AWS ECS, these are injected by the task definition from Secrets Manager
DB_HOST=localhost
DB_PORT=5432
DB_NAME=salesdb
DB_USER=etladmin
DB_PASSWORD=your-db-password-here

# SSL mode: 'require' for RDS, 'disable' for local docker-compose
DB_SSL_MODE=require

# ── ETL Behaviour ─────────────────────────────────────────────────────────────
# Number of rows per INSERT batch
BATCH_SIZE=500

# Max retries per stage on transient errors
MAX_RETRIES=3

# Seconds between retries (doubles each attempt: 5, 10, 20)
RETRY_DELAY_SECONDS=5

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# 'development' | 'production'
ENVIRONMENT=development

# ── Optional: explicit S3 key to process ─────────────────────────────────────
# Leave blank to auto-select the oldest file in input/
# S3_KEY=input/my-specific-file.csv
